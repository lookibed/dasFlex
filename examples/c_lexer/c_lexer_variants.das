        lx |> emit(CTok.LEFT_OP)
    }
    rule("\\+\\+") {
        lx |> emit(CTok.INC_OP)
    }
    rule("--") {
        lx |> emit(CTok.DEC_OP)
    }
    rule("->") {
        lx |> emit(CTok.PTR_OP)
    }
    rule("&&") {
        lx |> emit(CTok.AND_OP)
    }
    rule("\\|\\|") {
        lx |> emit(CTok.OR_OP)
    }
    rule("<=") {
        lx |> emit(CTok.LE_OP)
    }
    rule(">=") {
        lx |> emit(CTok.GE_OP)
    }
    rule("==") {
        lx |> emit(CTok.EQ_OP)
    }
    rule("!=") {
        lx |> emit(CTok.NE_OP)
    }
    rule(";|\\\{|\\\}|,|:|=|\\(|\\)|\\[|\\]|\\.|&|!|~|-|\\+|\\*|/|%|<|>|\\^|\\||\\?") {
        lx |> emit(c_byte_kind(lx))
    }
    condition("COMMENT", exclusive) {
        rule("\\*/") {
            lx |> begin("INITIAL")
        }
        rule("[^*]+") {
        }
        rule("\\*") {
        }
    }
}
